# 开发环境
VITE_APP_TITLE = 清玄侍
VITE_APP_ENV = development
# 接口前缀（走 vite proxy）
VITE_APP_BASE_API = /dev-api
# 代理目标：后期接后端时改成你的后端地址
VITE_APP_PROXY_TARGET = http://localhost:8080
# 路由基础路径
VITE_APP_ROUTER_BASE = /
# 文档地址（顶栏文档按钮）
VITE_APP_DOC_URL = https://element-plus.org
# 是否启用后端 AI 接口（false 时使用本地解析）
VITE_APP_AI_ENABLE = false
